{
  "_why": [
    "内环这几个白名单在 Rust 和 TypeScript 里各有一份手写实现（后端是权威，前端只是提前给出可读错误）。",
    "两份实现历史上漂移过五次：safe_word 前端只查了非空、ADB 路径一侧按字符另一侧按字节、",
    "C1 控制字符只有后端拒、辅测机 ID 少了 256 字节上限、measurement 默认值两侧不同。",
    "每次都表现为『界面保存成功、后端才拒绝』，配置一长就没法定位。",
    "这份语料是两侧共同的验收表：Rust 侧由 inner::tests 断言，前端侧由 inner-corpus.test.ts 断言。",
    "改任何一侧的规则都必须先改这里，然后两边一起变红——这就是防止第六次漂移的机制。",
    "repeat: [片段, 次数] 是 value 的等价写法，避免在 JSON 里写 513 个 a；tail 接在最后，用于「很长的目录 + 固定文件名」这类长度边界。"
  ],
  "limits": {
    "_why": "这两个上限没有独立谓词（在 validate() 里内联），所以按常量比对：两侧源码里的数字必须一致。",
    "agent_address_bytes": 256,
    "agent_token_bytes": 4096
  },
  "cases": [
    { "field": "size_token", "value": "1", "valid": true, "why": "最小合法值" },
    { "field": "size_token", "value": "256k", "valid": true, "why": "小写后缀" },
    { "field": "size_token", "value": "1M", "valid": true, "why": "大写后缀" },
    { "field": "size_token", "value": "1g", "valid": true, "why": "g 后缀" },
    { "field": "size_token", "value": "999999999999", "valid": true, "why": "12 位数字是上限" },
    { "field": "size_token", "value": "1234567890123", "valid": false, "why": "13 位超上限" },
    { "field": "size_token", "value": "0", "valid": false, "why": "0 不是有效尺寸" },
    { "field": "size_token", "value": "", "valid": false, "why": "空值" },
    { "field": "size_token", "value": "1kk", "valid": false, "why": "只允许一个后缀" },
    { "field": "size_token", "value": "1kb", "valid": false, "why": "b 不在后缀白名单" },
    { "field": "size_token", "value": "-1", "valid": false, "why": "负号会被当 iperf3 参数" },
    { "field": "size_token", "value": "1 m", "valid": false, "why": "空格拆成两个参数" },
    { "field": "size_token", "value": "１", "valid": false, "why": "全角数字不是 ASCII 数字" },

    { "field": "safe_word", "value": "eth0", "valid": true, "why": "普通词" },
    { "field": "safe_word", "value": "/usr/bin/iperf3", "valid": true, "why": "斜杠在白名单里" },
    { "field": "safe_word", "value": "a:b-c_d.e", "valid": true, "why": "白名单全部符号" },
    { "field": "safe_word", "repeat": ["a", 256], "valid": true, "why": "256 字节是上限" },
    { "field": "safe_word", "repeat": ["a", 257], "valid": false, "why": "257 字节超上限" },
    { "field": "safe_word", "value": "", "valid": false, "why": "空值" },
    { "field": "safe_word", "value": "-x", "valid": false, "why": "前导减号会被当参数" },
    { "field": "safe_word", "value": "a b", "valid": false, "why": "空格拆成两个参数" },
    { "field": "safe_word", "value": "a\u0000b", "valid": false, "why": "NUL" },
    { "field": "safe_word", "value": "a\u009fb", "valid": false, "why": "C1 控制字符" },
    { "field": "safe_word", "value": "中文", "valid": false, "why": "非 ASCII" },
    { "field": "safe_word", "value": "a\\b", "valid": false, "why": "反斜杠不在白名单" },

    { "field": "iface_word", "value": "br0", "valid": true, "why": "默认板侧桥" },
    { "field": "iface_word", "value": "eth0.100", "valid": true, "why": "VLAN 子接口带点" },
    { "field": "iface_word", "value": "en0:1", "valid": true, "why": "别名带冒号" },
    { "field": "iface_word", "repeat": ["a", 32], "valid": true, "why": "32 字节是上限" },
    { "field": "iface_word", "repeat": ["a", 33], "valid": false, "why": "33 字节超上限" },
    { "field": "iface_word", "value": ".", "valid": false, "why": "当前目录会拼出 /sys/class/net/./..." },
    { "field": "iface_word", "value": "..", "valid": false, "why": "上级目录逃出网卡目录" },
    { "field": "iface_word", "value": "", "valid": false, "why": "空值" },
    { "field": "iface_word", "value": "-x", "valid": false, "why": "前导减号" },
    { "field": "iface_word", "value": "a/b", "valid": false, "why": "斜杠拼出别的路径" },
    { "field": "iface_word", "value": "a\\b", "valid": false, "why": "反斜杠不在白名单" },
    { "field": "iface_word", "value": "a\u0000", "valid": false, "why": "NUL" },

    { "field": "adb_program", "value": "adb", "valid": true, "why": "裸文件名走 PATH" },
    { "field": "adb_program", "value": "/usr/local/bin/adb", "valid": true, "why": "绝对路径" },
    { "field": "adb_program", "value": "C:\\Program Files\\platform-tools\\adb.exe", "valid": true, "why": "Windows 路径含反斜杠和空格——这正是它不能套 safe_word 的原因" },
    { "field": "adb_program", "value": "ADB.EXE", "valid": true, "why": "大小写不敏感" },
    { "field": "adb_program", "value": "  adb  ", "valid": true, "why": "两侧都先 trim" },
    { "field": "adb_program", "value": "", "valid": false, "why": "空值" },
    { "field": "adb_program", "value": "-adb", "valid": false, "why": "前导减号" },
    { "field": "adb_program", "value": "/bin/sh", "valid": false, "why": "这是整份配置里唯一会被当程序执行的字段" },
    { "field": "adb_program", "value": "/usr/bin/xadb", "valid": false, "why": "文件名必须是 adb（可带 .exe 与版本号）" },
    { "field": "adb_program", "value": "/usr/bin/adb-wrapper", "valid": false, "why": "前缀相同也不行：adb- 后面只能是版本号" },
    { "field": "adb_program", "value": "C:\\tools\\adbx.exe", "valid": false, "why": "前缀相同也不行" },
    { "field": "adb_program", "value": "adb.exe", "valid": true, "why": "Windows 的裸文件名同样走 PATH" },
    { "field": "adb_program", "value": "platform-tools/adb-1.0.41", "valid": true, "why": "带版本号的文件名，多版本并存时常见" },
    { "field": "adb_program", "value": "C:\\tools\\ADB-35.0.2.exe", "valid": true, "why": "带版本号的 .exe，大小写不敏感" },
    { "field": "adb_program", "value": "/usr/bin/adb-", "valid": false, "why": "adb- 后面必须是版本号" },
    { "field": "adb_program", "value": "/usr/bin/adb-1.0x", "valid": false, "why": "版本号只能是数字和点" },
    { "field": "adb_program", "value": "./platform-tools/adb", "valid": true, "why": "本机相对路径" },
    { "field": "adb_program", "value": "\\\\server\\share\\adb.exe", "valid": false, "why": "网络路径：这个字段会被主控当程序执行，只接受本机路径" },
    { "field": "adb_program", "value": "//server/share/adb", "valid": false, "why": "另一种写法的网络路径" },
    { "field": "adb_program", "value": "/\\server\\share\\adb.exe", "valid": false, "why": "混用分隔符的网络路径，Windows 会把它归一成同一个网络地址" },
    { "field": "adb_program", "value": "\\\\?\\C:\\platform-tools\\adb.exe", "valid": false, "why": "设备命名空间前缀一律不收" },
    { "field": "adb_program", "value": "adb\u0000", "valid": false, "why": "NUL" },
    { "field": "adb_program", "value": "adb\u009f", "valid": false, "why": "C1 控制字符——前端曾经只覆盖到 U+007F" },
    { "field": "adb_program", "repeat": ["a", 509], "valid": false, "why": "文件名不是 adb" },
    { "field": "adb_program", "value": "/", "repeat": ["a", 507], "tail": "/adb", "valid": true, "why": "512 字节是上限" },
    { "field": "adb_program", "value": "/", "repeat": ["a", 508], "tail": "/adb", "valid": false, "why": "513 字节超上限" }
  ]
}
